<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="ModernWindowBackground" Color="#212121"/>
    <SolidColorBrush x:Key="ModernWindowHighlight" Color="#4080FF"/>

    <Style x:Key="ModernWindowBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource ModernWindowHighlight}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    
</ResourceDictionary>